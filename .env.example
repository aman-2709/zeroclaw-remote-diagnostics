# ZeroClaw Remote Diagnostics — Environment Variables

# ─── Database ───
DATABASE_URL=postgres://zcadmin:changeme@localhost:5432/zeroclaw
DATABASE_MAX_CONNECTIONS=10

# ─── Cloud API ───
HOST=127.0.0.1
PORT=3000
# Required when HOST is non-loopback. Generate with:
# openssl rand -base64 32
API_AUTH_TOKEN=
# Comma-separated browser origins, e.g. https://console.example.com
CORS_ORIGINS=
# Set only for explicitly isolated local development with plaintext MQTT.
ALLOW_INSECURE=false
MAX_BODY_BYTES=1048576

# ─── AWS ───
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com

# ─── MQTT (Edge Agent) ───
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_CLIENT_CERT=/etc/zeroclaw/certs/device.pem
MQTT_CLIENT_KEY=/etc/zeroclaw/certs/device.key
MQTT_CA_CERT=/etc/zeroclaw/certs/AmazonRootCA1.pem

# ─── Edge Agent ───
FLEET_ID=default
DEVICE_ID=rpi-001
CAN_INTERFACE=can0
OLLAMA_URL=http://localhost:11434

# ─── Bedrock (Cloud Fallback) ───
BEDROCK_MODEL_DEFAULT=amazon.nova-lite-v1:0
BEDROCK_MODEL_ESCALATION=anthropic.claude-3-haiku-20240307-v1:0
